# Public hostname served by nginx-proxy (also used for Host header validation)
VIRTUAL_HOST=

# Secret protecting the MCP endpoint /mcp (>= 32 chars): openssl rand -hex 32
MCP_API_KEY=

# Secret protecting the read-only REST API /api/v1 (>= 32 chars, different from MCP_API_KEY): openssl rand -hex 32
# training uses this value as its GARMIN_API_KEY.
REST_API_KEY=

# Personal API key from Garmin Connect web > Personal API Key (shown only once, has an expiry)
GARMIN_PERSONAL_API_KEY=

# Optional: uid/gid the container runs as, owner of ./garmin_tokens (default 1000:1000, see `id -u` / `id -g`)
# PUID=1000
# PGID=1000
